{
  "uid": "sokar-voice-slo",
  "title": "Sokar — Voice & SLO",
  "tags": ["sokar", "voice", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environnement",
        "type": "custom",
        "query": "production,staging",
        "current": { "text": "production", "value": "production" },
        "includeAll": true,
        "multi": true,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "État des SLO",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sokar_slo_status{env=~\"$env\"}",
          "legendFormat": "{{slo}}",
          "instant": true
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "Tenu", "color": "green", "index": 0 },
                "0": { "text": "Manqué", "color": "red", "index": 1 },
                "-1": { "text": "Non mesuré", "color": "text", "index": 2 }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Sessions vocales simultanées (seuil d'alerte : 70)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sokar_voice_active_sessions{env=~\"$env\"}",
          "legendFormat": "{{env}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 70 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Erreurs fournisseurs voice (par type)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, type) (rate(sokar_voice_provider_errors_total{env=~\"$env\"}[5m]))",
          "legendFormat": "{{provider}} · {{type}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p95 latence Sokar Connect (routes réussies)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sokar_connect_request_duration_ms_bucket{env=~\"$env\", status=\"2xx\"}[5m])))",
          "legendFormat": "p95 Connect"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "p95 premier token LLM (TTFT vocal)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sokar_voice_llm_first_token_ms_bucket{env=~\"$env\"}[5m])))",
          "legendFormat": "p95 TTFT"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "p95 premier audio TTS",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sokar_voice_tts_first_audio_ms_bucket{env=~\"$env\"}[5m])))",
          "legendFormat": "p95 premier audio"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "TurnPlan shadow observés (24 h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 22 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(sokar_voice_turn_plan_shadow_observations_total{env=~\"$env\"}[24h]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "noValue": "Aucune observation"
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Plans structurés valides (24 h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 22 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(increase(sokar_voice_turn_plan_shadow_observations_total{env=~\"$env\",status=\"valid\"}[24h])) / (sum(increase(sokar_voice_turn_plan_shadow_observations_total{env=~\"$env\"}[24h])) > 0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "noValue": "Aucune observation"
      },
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100 },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Plans acceptés par la policy (24 h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 22 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(increase(sokar_voice_turn_plan_shadow_observations_total{env=~\"$env\",policy_outcome=\"accepted\"}[24h])) / (sum(increase(sokar_voice_turn_plan_shadow_observations_total{env=~\"$env\",policy_outcome=~\"accepted|rejected\"}[24h])) > 0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "noValue": "Aucun plan évaluable"
      },
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100 },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Accord avec l’état après policy (24 h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 22 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(increase(sokar_voice_turn_plan_shadow_observations_total{env=~\"$env\",agreement=\"agree\"}[24h])) / (sum(increase(sokar_voice_turn_plan_shadow_observations_total{env=~\"$env\",agreement=~\"agree|disagree\"}[24h])) > 0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "noValue": "Aucun plan comparable"
      },
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100 },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Résultats TurnPlan par statut (volume horaire)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 27 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(sokar_voice_turn_plan_shadow_observations_total{env=~\"$env\"}[1h]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Accord TurnPlan par dimension (24 h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 35 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (dimension) (increase(sokar_voice_turn_plan_shadow_dimension_total{env=~\"$env\",agreement=\"agree\"}[24h])) / (sum by (dimension) (increase(sokar_voice_turn_plan_shadow_dimension_total{env=~\"$env\"}[24h])) > 0)",
          "instant": true,
          "legendFormat": "{{dimension}}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "noValue": "Aucun plan comparable"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Autorité TurnPlan canary par champ (volume horaire)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 35 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (field, outcome) (increase(sokar_voice_turn_plan_authority_total{env=~\"$env\"}[1h]))",
          "legendFormat": "{{field}} · {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Tours confiés au modèle par résultat (volume horaire)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 42 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(sokar_voice_turn_plan_deferred_total{env=~\"$env\"}[1h]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": []
      }
    }
  ]
}
