enum CustomerDataSource {
  MANUAL
  RESERVATION
  VOICE_SUGGESTION
  POS
  IMPORT
}

model CustomerPreference {
  id           String             @id @default(uuid())
  customerId   String             @map("customer_id")
  restaurantId String             @map("restaurant_id")
  key          String
  value        Json
  source       CustomerDataSource
