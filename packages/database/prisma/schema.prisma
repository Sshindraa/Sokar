  confirmedAt  DateTime?          @map("confirmed_at")
  expiresAt    DateTime?          @map("expires_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([customerId, key], map: "customer_preferences_customer_key_key")
  @@index([restaurantId, key], map: "customer_preferences_restaurant_key_idx")
  @@index([customerId, expiresAt], map: "customer_preferences_customer_expires_idx")
  @@map("customer_preferences")
}

model CustomerTag {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  key          String
  label        String
  colorToken   String?  @map("color_token")
  isSystem     Boolean  @default(false) @map("is_system")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant  Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  assignments CustomerTagAssignment[]

  @@unique([restaurantId, key], map: "customer_tags_restaurant_key_key")
  @@index([restaurantId, updatedAt(sort: Desc)], map: "customer_tags_restaurant_updated_idx")
  @@map("customer_tags")
}

model CustomerTagAssignment {
  customerId  String             @map("customer_id")
  tagId       String             @map("tag_id")
  source      CustomerDataSource
  ruleId      String?            @map("rule_id")
  ruleVersion Int?               @map("rule_version")
  assignedAt  DateTime           @default(now()) @map("assigned_at")

  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([tagId, assignedAt], map: "customer_tag_assignments_tag_assigned_idx")
  @@index([customerId, assignedAt], map: "customer_tag_assignments_customer_assigned_idx")
  @@map("customer_tag_assignments")
}

model CustomerSegment {
  id                String    @id @default(uuid())
  restaurantId      String    @map("restaurant_id")
  name              String
  definition        Json
  definitionVersion Int       @default(1) @map("definition_version")
  isSystem          Boolean   @default(false) @map("is_system")
  systemKey         String?   @map("system_key")
  lastCount         Int?      @map("last_count")
  lastEvaluatedAt   DateTime? @map("last_evaluated_at")
  createdByHash     String    @map("created_by_hash")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  campaigns  MarketingCampaign[]

  @@unique([restaurantId, systemKey], map: "customer_segments_restaurant_system_key_key")
  @@index([restaurantId, updatedAt(sort: Desc)], map: "customer_segments_restaurant_updated_idx")
  @@map("customer_segments")
}

enum MarketingChannel {
  SMS
  EMAIL
  WHATSAPP
}

enum MarketingPermissionStatus {
  OPTED_IN
  OPTED_OUT
  UNKNOWN
}

enum MarketingCampaignStatus {
  DRAFT
  READY
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
  FAILED
}

enum MarketingMessageStatus {
  PENDING
  SENDING
  ACCEPTED
  SENT
  DELIVERED
  FAILED
  BOUNCED
  COMPLAINED
  CANCELLED
}

enum MarketingProviderReconciliationStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum MarketingConversionType {
  RESERVATION_CREATED
  RESERVATION_HONORED
}

/// Current per-channel marketing permission. The legacy CustomerConsent
/// remains readable during migration; this projection is the authority for
/// campaign sends once a channel-specific proof has been collected.
model MarketingPermission {
  id           String                    @id @default(uuid())
  restaurantId String                    @map("restaurant_id")
  customerId   String                    @map("customer_id")
  channel      MarketingChannel
  status       MarketingPermissionStatus @default(UNKNOWN)
  source       String
  proofVersion String?                   @map("proof_version")
  proofHash    String?                   @map("proof_hash")
  consentedAt  DateTime?                 @map("consented_at")
  withdrawnAt  DateTime?                 @map("withdrawn_at")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")

  restaurant Restaurant                 @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  events     MarketingPermissionEvent[]

  @@unique([customerId, channel], map: "marketing_permissions_customer_channel_key")
  @@index([restaurantId, channel, status], map: "marketing_permissions_restaurant_channel_status_idx")
  @@index([customerId, updatedAt], map: "marketing_permissions_customer_updated_idx")
  @@map("marketing_permissions")
}

/// Append-only proof/audit trail for every permission change.
model MarketingPermissionEvent {
  id           String                    @id @default(uuid())
  restaurantId String                    @map("restaurant_id")
  customerId   String                    @map("customer_id")
  permissionId String?                   @map("permission_id")
  channel      MarketingChannel
  status       MarketingPermissionStatus
  source       String
  proofVersion String?                   @map("proof_version")
  proofHash    String?                   @map("proof_hash")
  occurredAt   DateTime                  @map("occurred_at")
  createdAt    DateTime                  @default(now()) @map("created_at")

  restaurant Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  permission MarketingPermission? @relation(fields: [permissionId], references: [id], onDelete: SetNull)

  @@index([restaurantId, channel, occurredAt], map: "marketing_permission_events_restaurant_channel_idx")
  @@index([customerId, channel, occurredAt], map: "marketing_permission_events_customer_channel_idx")
  @@map("marketing_permission_events")
}

/// Explicit operator/provider suppression. A suppression always wins over an
/// opt-in and is checked again immediately before a provider call.
model MarketingSuppression {
  id           String            @id @default(uuid())
  restaurantId String            @map("restaurant_id")
  customerId   String            @map("customer_id")
  channel      MarketingChannel?
  reason       String
  source       String
  expiresAt    DateTime?         @map("expires_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, channel, reason], map: "marketing_suppressions_customer_channel_reason_key")
  @@index([restaurantId, customerId, expiresAt], map: "marketing_suppressions_lookup_idx")
  @@map("marketing_suppressions")
}

model MarketingCampaign {
  id              String                  @id @default(uuid())
  restaurantId    String                  @map("restaurant_id")
  eventId         String?                 @map("event_id")
  name            String
  objective       String
  channel         MarketingChannel
  segmentId       String?                 @map("segment_id")
  status          MarketingCampaignStatus @default(DRAFT)
  subject         String?
  bodyTemplate    String                  @map("body_template")
  scheduledAt     DateTime?               @map("scheduled_at")
  timezone        String                  @default("Europe/Paris")
  audienceVersion Int                     @default(1) @map("audience_version")
  audienceCount   Int                     @default(0) @map("audience_count")
  acceptedCount   Int                     @default(0) @map("accepted_count")
  deliveredCount  Int                     @default(0) @map("delivered_count")
  failedCount     Int                     @default(0) @map("failed_count")
  conversionCount Int                     @default(0) @map("conversion_count")
  startedAt       DateTime?               @map("started_at")
  completedAt     DateTime?               @map("completed_at")
  lastErrorCode   String?                 @map("last_error_code")
  createdByHash   String                  @map("created_by_hash")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  restaurant           Restaurant                    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  event                Event?                        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  segment              CustomerSegment?              @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  audienceMembers      CampaignAudienceMember[]
  messages             CampaignMessage[]
  conversions          MarketingConversion[]
  attributionLinks     MarketingAttributionLink[]
  automationDispatches MarketingAutomationDispatch[]
  legacyReactivation   ReactivationCampaign?

  @@index([restaurantId, status, updatedAt(sort: Desc)], map: "marketing_campaigns_restaurant_status_updated_idx")
  @@index([segmentId], map: "marketing_campaigns_segment_idx")
  @@index([eventId], map: "marketing_campaigns_event_idx")
  @@map("marketing_campaigns")
}

enum MarketingAutomationType {
  AFTER_FIRST_HONORED
  DORMANT
  BIRTHDAY
}

enum MarketingAutomationDispatchStatus {
  QUEUED
  SENT
  SKIPPED
  FAILED
}

/// Configuration for the three bounded Pro automations. The service validates
/// the JSON by type before it can be enabled; no client supplied JSON is ever
/// compiled directly into a query or provider payload.
model MarketingAutomation {
  id              String                  @id @default(uuid())
  restaurantId    String                  @map("restaurant_id")
  type            MarketingAutomationType
  channel         MarketingChannel
  config          Json
  version         Int                     @default(1)
  enabled         Boolean                 @default(false)
  lastEvaluatedAt DateTime?               @map("last_evaluated_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  restaurant Restaurant                    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dispatches MarketingAutomationDispatch[]

  @@unique([restaurantId, type], map: "marketing_automations_restaurant_type_key")
  @@index([enabled, type], map: "marketing_automations_enabled_type_idx")
  @@index([restaurantId, enabled], map: "marketing_automations_restaurant_enabled_idx")
  @@map("marketing_automations")
}

/// One durable claim per automation/customer/trigger. It prevents a scheduler
/// replay or a concurrent API instance from producing a second campaign
/// message, even when Redis is unavailable.
model MarketingAutomationDispatch {
  id           String                            @id @default(uuid())
  automationId String                            @map("automation_id")
  restaurantId String                            @map("restaurant_id")
  customerId   String                            @map("customer_id")
  triggerKey   String                            @map("trigger_key")
  campaignId   String?                           @map("campaign_id")
  status       MarketingAutomationDispatchStatus @default(QUEUED)
  reasonCode   String?                           @map("reason_code")
  occurredAt   DateTime                          @map("occurred_at")
  createdAt    DateTime                          @default(now()) @map("created_at")
  updatedAt    DateTime                          @updatedAt @map("updated_at")

  automation MarketingAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaign   MarketingCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([automationId, customerId, triggerKey], map: "marketing_automation_dispatches_dedupe_key")
  @@index([restaurantId, status, createdAt], map: "marketing_automation_dispatches_restaurant_status_idx")
  @@index([campaignId], map: "marketing_automation_dispatches_campaign_idx")
  @@map("marketing_automation_dispatches")
}

model CampaignAudienceMember {
  id              String   @id @default(uuid())
  campaignId      String   @map("campaign_id")
  customerId      String   @map("customer_id")
  audienceVersion Int      @map("audience_version")
  inclusionReason String   @map("inclusion_reason")
  snapshot        Json     @default("{}")
  capturedAt      DateTime @map("captured_at")
  createdAt       DateTime @default(now()) @map("created_at")

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  message  CampaignMessage?

  @@unique([campaignId, customerId], map: "campaign_audience_members_campaign_customer_key")
  @@index([campaignId, audienceVersion], map: "campaign_audience_members_campaign_version_idx")
  @@map("campaign_audience_members")
}

model CampaignMessage {
  id                String                 @id @default(uuid())
  campaignId        String                 @map("campaign_id")
  audienceMemberId  String                 @unique @map("audience_member_id")
  customerId        String                 @map("customer_id")
  channel           MarketingChannel
  status            MarketingMessageStatus @default(PENDING)
  provider          String?
  providerMessageId String?                @map("provider_message_id")
  renderedBody      String?                @map("rendered_body")
  idempotencyKey    String                 @unique @map("idempotency_key")
  errorCode         String?                @map("error_code")
  acceptedAt        DateTime?              @map("accepted_at")
  sentAt            DateTime?              @map("sent_at")
  deliveredAt       DateTime?              @map("delivered_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  campaign                MarketingCampaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  audienceMember          CampaignAudienceMember            @relation(fields: [audienceMemberId], references: [id], onDelete: Cascade)
  customer                Customer                          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  providerReconciliations MarketingProviderReconciliation[]

  @@index([campaignId, status], map: "campaign_messages_campaign_status_idx")
  @@index([customerId, channel, createdAt], map: "campaign_messages_customer_channel_idx")
  @@map("campaign_messages")
}

/// Durable inbox for a signed provider callback whose message id could not be
/// matched at receipt time. It contains only provider metadata, never a
/// contact address or message body. The reconciliation job can attach the row
/// to a CampaignMessage once the send transaction becomes visible.
model MarketingProviderReconciliation {
  id                String                                @id @default(uuid())
  eventKey          String                                @unique @map("event_key")
  provider          String
  providerMessageId String                                @map("provider_message_id")
  eventType         String                                @map("event_type")
  providerStatus    String?                               @map("provider_status")
  errorCode         String?                               @map("error_code")
  payloadHash       String?                               @map("payload_hash")
  occurredAt        DateTime                              @map("occurred_at")
  status            MarketingProviderReconciliationStatus @default(OPEN)
  restaurantId      String?                               @map("restaurant_id")
  campaignMessageId String?                               @map("campaign_message_id")
  attempts          Int                                   @default(1)
  firstSeenAt       DateTime                              @default(now()) @map("first_seen_at")
  lastSeenAt        DateTime                              @default(now()) @map("last_seen_at")
  resolvedAt        DateTime?                             @map("resolved_at")
  resolutionCode    String?                               @map("resolution_code")
  createdAt         DateTime                              @default(now()) @map("created_at")
  updatedAt         DateTime                              @updatedAt @map("updated_at")

  restaurant      Restaurant?      @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  campaignMessage CampaignMessage? @relation(fields: [campaignMessageId], references: [id], onDelete: SetNull)

  @@index([status, lastSeenAt], map: "marketing_provider_reconciliation_status_seen_idx")
  @@index([provider, providerMessageId], map: "marketing_provider_reconciliation_provider_message_idx")
  @@index([restaurantId, status, lastSeenAt], map: "marketing_provider_reconciliation_restaurant_status_idx")
  @@map("marketing_provider_reconciliations")
}

model MarketingConversion {
  id             String                  @id @default(uuid())
  campaignId     String                  @map("campaign_id")
  customerId     String                  @map("customer_id")
  reservationId  String?                 @map("reservation_id")
  conversionType MarketingConversionType @map("conversion_type")
  conversionKey  String                  @unique @map("conversion_key")
  attributedAt   DateTime                @map("attributed_at")
  windowEndsAt   DateTime?               @map("window_ends_at")
  active         Boolean                 @default(true)
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  campaign    MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reservation Reservation?      @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([campaignId, conversionType, attributedAt], map: "marketing_conversions_campaign_type_idx")
  @@index([reservationId, conversionType], map: "marketing_conversions_reservation_type_idx")
  @@map("marketing_conversions")
}

/// Signed, expiring campaign link. Only a hash of the token is persisted;
/// the customer id is never placed in a URL in clear text.
model MarketingAttributionLink {
  id           String    @id @default(uuid())
  restaurantId String    @map("restaurant_id")
  campaignId   String    @map("campaign_id")
  customerId   String    @map("customer_id")
  tokenHash    String    @unique @map("token_hash")
  issuedAt     DateTime  @map("issued_at")
  expiresAt    DateTime  @map("expires_at")
  clickedAt    DateTime? @map("clicked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer   Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId], map: "marketing_attribution_links_campaign_customer_key")
  @@index([restaurantId, expiresAt], map: "marketing_attribution_links_restaurant_expiry_idx")
  @@index([campaignId, clickedAt], map: "marketing_attribution_links_campaign_clicked_idx")
  @@map("marketing_attribution_links")
}

model MarketingFrequencyWindow {
  id           String           @id @default(uuid())
  restaurantId String           @map("restaurant_id")
  customerId   String           @map("customer_id")
  channel      MarketingChannel
  windowStart  DateTime         @map("window_start")
  windowEnd    DateTime         @map("window_end")
  sendCount    Int              @default(0) @map("send_count")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, channel, windowStart], map: "marketing_frequency_windows_customer_channel_start_key")
  @@index([restaurantId, channel, windowEnd], map: "marketing_frequency_windows_lookup_idx")
  @@map("marketing_frequency_windows")
}

model Message {
  id            String     @id @default(uuid())
  restaurantId  String     @map("restaurant_id")
  callId        String?    @map("call_id")
  customerName  String     @map("customer_name")
  customerPhone String?    @map("customer_phone")
  content       String
  status        String     @default("PENDING")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at")
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  call          Call?      @relation(fields: [callId], references: [id])

  @@index([restaurantId, status, createdAt(sort: Desc)], map: "messages_restaurant_status_created_at_idx")
  @@map("messages")
}

model ReactivationCampaign {
  id                  String             @id @default(uuid())
  restaurantId        String             @map("restaurant_id")
  status              String             @default("PENDING") // PENDING | MIGRATED | SENT | DISMISSED
  customerIds         String[]           @map("customer_ids") // snapshot des VIPs dormants
  marketingCampaignId String?            @unique @map("marketing_campaign_id")
  sentAt              DateTime?          @map("sent_at")
  sentCount           Int                @default(0) @map("sent_count")
  createdAt           DateTime           @default(now()) @map("created_at")
  restaurant          Restaurant         @relation(fields: [restaurantId], references: [id])
  marketingCampaign   MarketingCampaign? @relation(fields: [marketingCampaignId], references: [id], onDelete: SetNull)

  @@index([restaurantId, status, createdAt(sort: Desc)], map: "reactivation_campaigns_restaurant_status_created_at_idx")
  @@map("reactivation_campaigns")
}

model LatencyTrace {
  id             String   @id @default(uuid())
  callId         String   @unique @map("call_id")
  vadEndMs       Int?     @map("vad_end_ms")
  sttFinalMs     Int?     @map("stt_final_ms")
  llmFirstToken  Int?     @map("llm_first_token_ms")
  ttsFirstByte   Int?     @map("tts_first_byte_ms")
  audioPlayingMs Int?     @map("audio_playing_ms")
  totalE2eMs     Int?     @map("total_e2e_ms")
  createdAt      DateTime @default(now()) @map("created_at")
  call           Call     @relation(fields: [callId], references: [id])

  @@map("latency_traces")
}

/// Bilan durable d'un appel vocal. Les métriques par tour sont conservées
/// séparément dans VoiceTurnTelemetry ; cette ligne sert aux KPIs et au
/// diagnostic d'un appel entier sans dépendre de la dernière réponse.
model VoiceCallTelemetry {
  id                         String    @id @default(uuid())
  callId                     String    @unique @map("call_id")
  llmProvider                String?   @map("llm_provider")
  llmModel                   String?   @map("llm_model")
  totalSpeechMs              Int?      @map("total_speech_ms")
  totalTranscriptionMs       Int?      @map("total_transcription_ms")
  totalLlmMs                 Int?      @map("total_llm_ms")
  totalAvailabilityMs        Int?      @map("total_availability_ms")
  totalTtsMs                 Int?      @map("total_tts_ms")
  firstLlmFirstTokenMs       Int?      @map("first_llm_first_token_ms")
  firstLlmFirstPhraseMs      Int?      @map("first_llm_first_phrase_ms")
  firstTtsFirstAudioMs       Int?      @map("first_tts_first_audio_ms")
  firstSttFinalToAudioMs     Int?      @map("first_stt_final_to_audio_ms")
  turnCount                  Int       @default(0) @map("turn_count")
  llmTurnCount               Int       @default(0) @map("llm_turn_count")
  deterministicTurnCount     Int       @default(0) @map("deterministic_turn_count")
  fallbackTurnCount          Int       @default(0) @map("fallback_turn_count")
  availabilitySearchCount    Int       @default(0) @map("availability_search_count")
  availabilityFailureCount   Int       @default(0) @map("availability_failure_count")
  loopCount                  Int       @default(0) @map("loop_count")
  reservationConfirmed       Boolean   @default(false) @map("reservation_confirmed")
  reservationIntentAbandoned Boolean   @default(false) @map("reservation_intent_abandoned")
  finalizedAt                DateTime? @map("finalized_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")
  call                       Call      @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@map("voice_call_telemetry")
}

/// Chronologie structurée d'un tour vocal. Une ligne est réécrite uniquement
/// pour le même (appel, turnId), jamais remplacée par le tour suivant.
model VoiceTurnTelemetry {
  id                      String    @id @default(uuid())
  callId                  String    @map("call_id")
  turnId                  String    @map("turn_id")
  sequence                Int
  path                    String    @default("unknown")
  transcriptLength        Int       @default(0) @map("transcript_length")
  transcriptFingerprint   String?   @map("transcript_fingerprint")
  speechDurationMs        Int?      @map("speech_duration_ms")
  transcriptionDurationMs Int?      @map("transcription_duration_ms")
  speechToSttFinalMs      Int?      @map("speech_to_stt_final_ms")
  llmFirstTokenMs         Int?      @map("llm_first_token_ms")
  llmFirstPhraseMs        Int?      @map("llm_first_phrase_ms")
  llmDurationMs           Int?      @map("llm_duration_ms")
  availabilityDurationMs  Int?      @map("availability_duration_ms")
  ttsFirstByteMs          Int?      @map("tts_first_byte_ms")
  sttFinalToAudioMs       Int?      @map("stt_final_to_audio_ms")
  ttsDurationMs           Int?      @map("tts_duration_ms")
  totalE2eMs              Int?      @map("total_e2e_ms")
  sttProvider             String?   @map("stt_provider")
  llmProvider             String?   @map("llm_provider")
  llmModel                String?   @map("llm_model")
  ttsProvider             String?   @map("tts_provider")
  availabilitySearches    Int       @default(0) @map("availability_searches")
  availabilityFailures    Int       @default(0) @map("availability_failures")
  loopDetected            Boolean   @default(false) @map("loop_detected")
  interrupted             Boolean   @default(false)
  completed               Boolean   @default(false)
  startedAt               DateTime  @map("started_at")
  endedAt                 DateTime? @map("ended_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  call                    Call      @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([callId, turnId], map: "voice_turn_telemetry_call_turn_key")
  @@index([callId, sequence], map: "voice_turn_telemetry_call_sequence_idx")
  @@index([callId, path], map: "voice_turn_telemetry_call_path_idx")
  @@map("voice_turn_telemetry")
}

/// Dialogue d'un tour (paroles du client, réponses de l'agent, outils), gardé
/// 14 jours pour les seuls restaurants de VOICE_DEBUG_TRANSCRIPT_RESTAURANT_IDS.
/// Jamais écrit pour un restaurant client. Mesures du tour : voice_turn_telemetry.
model VoiceDebugTurn {
  id           String   @id @default(uuid())
  callId       String   @map("call_id")
  restaurantId String   @map("restaurant_id")
  turnId       String   @map("turn_id")
  sequence     Int
  callerText   String?  @map("caller_text")
  agentText    String?  @map("agent_text")
  fillerText   String?  @map("filler_text")
  speechAct    String?  @map("speech_act")
  tools        String[] @default([])
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  call         Call     @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([callId, turnId], map: "voice_debug_turns_call_turn_key")
  @@index([restaurantId, createdAt], map: "voice_debug_turns_restaurant_created_at_idx")
  @@index([expiresAt], map: "voice_debug_turns_expires_at_idx")
  @@map("voice_debug_turns")
}

